# LLM API Configuration
# ======================
# Works with any provider supported by litellm (OpenAI, Anthropic, Cohere, Google, etc.)

# Required: Your API key for the LLM provider
LLM_API_KEY=sk-...

# Required: Model identifier (examples below)
# OpenAI: gpt-4o, gpt-4-turbo, o1, o3-mini
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# Google: gemini/gemini-2.0-flash-exp
# Cohere: command-r-plus
LLM_MODEL=gpt-4o

# Optional: Temperature for response randomness (0.0 to 2.0)
# Lower values (e.g., 0.1) make output more deterministic
# Higher values (e.g., 1.5) make output more creative
# Default: 0.7
LLM_TEMPERATURE=0.7

# TODO determine how to include reasoning effort into litellm
# LLM_REASONING_EFFORT=low
